# Postgres (Neon). Use a URL de conexão "pooled" em produção.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública do sistema (ex.: https://imperium.vercel.app)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Protege a rotina diária (Vercel Cron envia "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=
# Vercel Blob PRIVADO (fotos, assinaturas, comprovantes). Sem ele, os arquivos ficam em .data/uploads (só desenvolvimento).
BLOB_READ_WRITE_TOKEN=
